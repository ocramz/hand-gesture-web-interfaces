{
  "name": "@ocramz/handpose",
  "version": "0.1.0",
  "author": "ocramz",
  "license": "AGPL-3.0-only",
  "description": "Webcam hand pose in the browser: YOLO26 in onnxruntime-web or tract (wasm), in a worker; tracking, 2D → 3D lifting. Model weights included.",
  "keywords": [
    "hand-pose",
    "hand-tracking",
    "webcam",
    "onnx",
    "onnxruntime-web",
    "webgpu",
    "wasm",
    "yolo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ocramz/hand-gesture-web-interfaces.git",
    "directory": "packages/handpose"
  },
  "homepage": "https://github.com/ocramz/hand-gesture-web-interfaces/tree/main/packages/handpose#readme",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./models/*": "./assets/models/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "tract/pkg/*.js",
    "tract/pkg/*.d.ts",
    "tract/pkg/*.wasm",
    "tract/pkg/snippets",
    "assets/models/*.onnx",
    "LICENSE",
    "NOTICE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run build:wasm && npm run build:ts",
    "build:ts": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:wasm": "bash scripts/build-wasm.sh",
    "watch": "tsc -p tsconfig.build.json --watch",
    "test": "node --test tests/*.test.ts && cargo test --release --manifest-path tract/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "fetch-model": "bash scripts/fetch-model.sh"
  },
  "dependencies": {
    "onnxruntime-web": "1.31.1"
  }
}
